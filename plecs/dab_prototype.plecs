        Show          off
      }
      Parameter {
        Variable      "Parameters"
        Value         "[Lk, n, f_s, T_calc]"
        Show          off
      }
      Parameter {
        Variable      "LangStandard"
        Value         "2"
        Show          off
      }
      Parameter {
        Variable      "GnuExtensions"
        Value         "1"
        Show          off
      }
      Parameter {
        Variable      "RuntimeCheck"
        Value         "2"
        Show          off
      }
      Parameter {
        Variable      "HighlightLevel"
        Value         "0"
        Show          off
      }
      Parameter {
        Variable      "Declarations"
        Value         "#include <math.h>\n"
"#include \"./src/dab_control.h\"\n"
"#include \"./src/dab_control.c\"\n"
"\n"
"#define M_L ParamRealData(0,0)\n"
"#define M_n ParamRealData(0,1)\n"
"#define M_f_s ParamRealData(0,2)\n"
"#define M_T_calc ParamRealData(0,3)\n"
"\n"
"modulator_t modulator = {.d1 = 0.0f, .d2 = 0.0f, .phi = 0.0f};\n"
"\n"
"volatile control_t control = {\n"
"\t\t.enable = true,\n"
"\t\t.update_pi_constant = true,\n"
"\t\t.enable = false,\n"
"\t\t.control_mode_ref = open_loop,\n"
"\t\t.control_mode_act = open_loop,\n"
"\t\t.i_ref = 0.0f,\n"
"\t\t.i_ref_usr = 0.0f,\n"
"\t\t.phi_ref = 34.5f,\n"
"\t\t.phi_ref_usr = 34.5f,\n"
"\t\t.fs_ref = 120,\n"
"\t\t.fs_act\t= 120,\n"
"\t\t.bm_period = 12,\n"
"\t\t.bm_cmp = 6,\n"
"\t\t.update_deadtime = true,\n"
"\t\t.deadtime_hb1_ns = 967.0f, // LV side\n"
"\t\t.deadtime_hb2_ns = 867.0f, // HV side\n"
"\t\t.current_rate_limit_enable = false\n"
"};\n"
"\n"
"volatile pi_controller_t pi_controller = {\n"
"\t\t.u = {0.0f, 0.0f},\n"
"\t\t.e = {0.0f, 0.0f},\n"
"\t\t.b0 = 0.00538629f, \t// for 30 kHz\n"
"\t\t.b1 = -0.00535795f, // for 30 kHz\n"
"\t\t.k_p = 0.00537212f,\n"
"\t\t.k_i = 2.5f, // 0.85f, // 226.195f,\n"
"\t\t.t_s = 0.000033332f\n"
"};\n"
        Show          off
      }
      Parameter {
        Variable      "StartFcn"
        Value         "pi_controller.t_s = M_T_calc;\n"
        Show          off
      }
      Parameter {
        Variable      "OutputFcn"
        Value         "control.control_mode_act = InputSignal(0,0);\n"
"control.phi_ref_usr = InputSignal(1,0);\n"
"control.i_ref_usr = InputSignal(2,0);\n"
"float i_meas = InputSignal(3,0);\n"
"\n"
"float aux = 0.0f;\n"
"\n"
"modulator.phi = calc_control_loop(&control, &pi_controller, i_meas)/180.0f;\n"
"\n"
"aux = get_value();\n"
"\n"
"modulator.d1 = 1;\n"
"modulator.d2 = 2;\n"
"\n"
"OutputSignal(0,0) = modulator.d1;\n"
"OutputSignal(1,0) = modulator.d2;\n"
"OutputSignal(2,0) = modulator.phi;\n"
"OutputSignal(3,0) = aux;"
        Show          off
      }
      Parameter {
        Variable      "UpdateFcn"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "DerivativeFcn"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "TerminateFcn"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "StoreCustomStateFcn"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "RestoreCustomStateFcn"
        Value         ""
        Show          off
      }
    }
